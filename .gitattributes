# Root launchers: bit.ly/TBS_Maintenance_Script and bit.ly/MiniGhost point at these two files
# and cannot be changed, so they stay as small launchers (see README.md). LF, as before.
TBS_Maintenace_Script_V2.ps1    text eol=lf

# TBS Maintenance Script sources: Windows line endings in the working copy (PowerShell Studio
# friendly). The BUILT script (TBS_Maintenance/dist, git-ignored) is written with LF by
# Build.ps1 - its here-strings (SQL, generated worker scripts) expect LF line breaks.
TBS_Maintenance/**              text eol=crlf
TBS_Maintenance/**/*.png        binary
TBS_Maintenance/**/*.ico        binary

# MiniGhost sources: Windows line endings in the working copy. The built MiniGhost/MiniGhost.ps1 is
# committed (the bit.ly launcher downloads it from main) and stays byte-for-byte as Build.ps1 wrote
# it (ASCII, CRLF), so it is not converted.
MiniGhost/**                    text eol=crlf
MiniGhost/MiniGhost.ps1         -text

# Double-click launchers: batch files must keep CRLF
Run/*.bat                       text eol=crlf
