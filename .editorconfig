root = true

# TBS Maintenance Script sources: tabs (PowerShell Studio default), CRLF, ASCII only.
[TBS_Maintenance/**.{ps1,psd1,psm1}]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[TBS_Maintenance/**.md]
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
